{"assessment_date": "2018-03-12T00:00:00.000Z", "year_published": "2021", "latest": true, "possibly_extinct": false, "possibly_extinct_in_the_wild": false, "sis_taxon_id": 163458, "criteria": "A2cd", "url": "https://www.iucnredlist.org/species/163458/1009824", "citation": "Shepherd, C., Horne, B.D., Guntoro, J. & Cota, M. 2021. Batagur borneoensis. The IUCN Red List of Threatened Species 2021: e.T163458A1009824. Accessed on 07 March 2026.", "assessment_id": 1009824, "assessment_points": false, "assessment_ranges": true, "taxon": {"sis_id": 163458, "scientific_name": "Batagur borneoensis", "species_taxa": [], "subpopulation_taxa": [], "infrarank_taxa": [], "kingdom_name": "ANIMALIA", "phylum_name": "CHORDATA", "class_name": "REPTILIA", "order_name": "TESTUDINES", "family_name": "GEOEMYDIDAE", "genus_name": "Batagur", "species_name": "borneoensis", "subpopulation_name": null, "infra_name": null, "authority": "(Schlegel &amp; M\u00fcller, 1844)", "species": true, "subpopulation": false, "infrarank": false, "ssc_groups": [{"name": "IUCN SSC Tortoise and Freshwater Turtle Specialist Group", "url": "http://www.iucn-tftsg.org/", "description": "Chair: Craig Stanford (email: stanford@usc.edu)\nRed List Authority Coordinator: Carla Eisemberg (email:Carla.Eisemberg@cdu.edu.au)\nNewsletters: Chelonian Conservation and Biology (http://www.chelonian.org/ccb/); Turtle and Tortoise Newsletter (http://www.chelonian.org/crf-publications/turtle-and-tortoise-newsletter/); TurtleLog Online Newsletter (http://www.iucn-tftsg.org/turtlelog_online_newsletter/)"}], "common_names": [{"main": false, "name": "Painted Batagur", "language": "eng"}, {"main": false, "name": "Saw-jawed Terrapin", "language": "eng"}, {"main": false, "name": "Three-striped Batagur", "language": "eng"}, {"main": true, "name": "Painted Terrapin", "language": "eng"}], "synonyms": [{"name": "Callagur borneoensis (Schlegel & M\u00fcller, 1844)", "status": "ACCEPTED", "genus_name": "Callagur", "species_name": "borneoensis", "species_author": "(Schlegel & M\u00fcller, 1844)", "infrarank_author": null, "subpopulation_name": null, "infra_type": null, "infra_name": null}, {"name": "Emys borneoensis Schlegel & M\u00fcller, 1844", "status": "ACCEPTED", "genus_name": "Emys", "species_name": "borneoensis", "species_author": "Schlegel & M\u00fcller, 1844", "infrarank_author": null, "subpopulation_name": null, "infra_type": null, "infra_name": null}, {"name": "Kachuga major Gray, 1873", "status": "ACCEPTED", "genus_name": "Kachuga", "species_name": "major", "species_author": "Gray, 1873", "infrarank_author": null, "subpopulation_name": null, "infra_type": null, "infra_name": null}, {"name": "Batagur  picta Gray, 1862", "status": "ACCEPTED", "genus_name": "Batagur ", "species_name": "picta", "species_author": "Gray, 1862", "infrarank_author": null, "subpopulation_name": null, "infra_type": null, "infra_name": null}, {"name": "Kachuga brookei Bartlett, 1895", "status": "ACCEPTED", "genus_name": "Kachuga", "species_name": "brookei", "species_author": "Bartlett, 1895", "infrarank_author": null, "subpopulation_name": null, "infra_type": null, "infra_name": null}]}, "population_trend": {"description": {"en": "Decreasing"}, "code": "1"}, "red_list_category": {"version": "3.1", "description": {"en": "Critically Endangered"}, "code": "CR"}, "supplementary_info": {"area_restricted_is_restricted": null, "number_of_locations": null, "upper_elevation_limit": 20, "lower_elevation_limit": 0, "lower_depth_limit": null, "upper_depth_limit": null, "population_size": null, "population_severely_fragmented": "No", "population_continuing_decline": null, "generational_length": "45", "congregatory": null, "movement_patterns": null, "continuing_decline_in_area": null, "conservation_actions_in_place": [{"name": "In-place land/water protection", "actions": [{"name": "Occurs in at least one protected area", "value": "Yes"}]}, {"name": "In-place education", "actions": [{"name": "Included in international legislation", "value": "Yes"}, {"name": "Subject to any international management / trade controls", "value": "Yes"}]}], "identification_information": null, "extreme_fluctuations": "No", "no_of_subpopulations": null, "continuing_decline_in_subpopulations": null, "extreme_fluctuations_in_subpopulations": null, "all_individuals_in_one_subpopulation": null, "no_of_individuals_in_largest_subpopulation": null, "estimated_area_of_occupancy": null, "continuing_decline_in_area_of_occupancy": "Yes", "extreme_fluctuations_in_area_of_occupancy": null, "estimated_extent_of_occurence": null, "continuing_decline_in_extent_of_occurence": "Yes", "extreme_fluctuations_in_extent_of_occurence": null, "continuing_decline_in_number_of_locations": null, "extreme_fluctuations_in_number_of_locations": null}, "documentation": {"range": "The distribution of <em>Batagur borneoensis</em>, as currently understood,<em>&#160;</em>is in extreme southern peninsular Thailand, northeastern peninsular Malaysia, Indonesia (northern Sumatra and&#160;western Kalimantan), and Brunei. There is also a record from Jambi province in southern Sumatra, Indonesia (A. Hamidy pers. comm. 2018). The species was once more widely distributed through Southeast Asia, but it is presumed to have been extirpated from parts of its range.", "population": "There are no data on population size for this <em>Batagur borneoensis</em>. It was very common in the trade in many parts of its range about twenty years ago. At present, it appears in trade in Jakarta in very low numbers. The species has been eliminated from parts of its range due to trade, egg collection and sand mining. It is suspected that the population has been reduced by at least 80% due to these threats. None of these threats have ceased. If specimens are encountered, they are collected for trade. All collection is illegal, though there used to be a legal quota in Indonesia up to the early 2000s.", "habitats": "<em>Batagur borneoensis</em> occurs in estuaries, brackish waters and mangrove forests. It nests on beaches. Males mature early than females: males at 7\u201310 years old; females at about 15 years. It is assumed that the generation length for this species is approximately 45 years (three times the age of first reproduction). Based on these, three generations is estimated at 135 years.", "threats": "The main threats to <em>Batagur borneoensis</em> are illegal collection for consumption, collection of eggs and sand mining.", "measures": "<em>Batagur borneoensis</em> is listed in CITES Appendix II. The species is present in protected areas in Thailand and Sumatra. It inhabits forested areas and needs beaches to lay eggs, so both of these habitats need protection to ensure adequate conservation. Research is needed to better determine its current distribution, habitats and ecology, main threats, and the legality of egg collection in some areas.", "use_trade": "<em>Batagur borneoensis</em> is mainly in the illegal trade for consumption, with a small trade for pets. The species was intensively collected in the 1990s. The eggs of this species are collected for local consumption.", "rationale": "<em>Batagur borneoensis</em> used to occur widely in peninsular Malaysia, Thailand, northeastern Sumatra and eastern Borneo. It has been extirpated across most of the range due mainly to illegal collection, and it is also affected by egg collection for consumption and sand mining. It is suspected that the species' population has been reduced by at least 80% in the past three generations. Hence it is listed as Critically Endangered A2cd.", "trend_justification": null, "taxonomic_notes": null}, "biogeographical_realms": [{"description": {"en": "Indomalayan"}, "code": "3"}], "conservation_actions": [{"note": "", "code": "1_2", "description": {"en": "Resource & habitat protection"}}, {"note": "", "code": "1_1", "description": {"en": "Site/area protection"}}, {"note": "", "code": "5_1_4", "description": {"en": "Scale unspecified"}}, {"note": "", "code": "5_1